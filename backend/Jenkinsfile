pipeline{
    agent any
    tools{
        nodejs 'NODEJS23'
        
    }
    stages{
        stage('Install Dependencies')
        {
            steps{
            sh '''
               cd backend 
               npm install --no-audit
               '''
            }
        }

        stage('Dendency check-OWASP')
        {
            steps{
            sh '''
               cd backend 
               dependencyCheck additionalArguments: '--scan backend/ --out backend/OWASP-report  --disableYarnAudit --prettyPrint --format ALL', odcInstallation: 'DC-12', skipOnScmChange: true, skipOnUpstreamChange: true, stopBuild: true
               '''
            }
            
        }
    }
}