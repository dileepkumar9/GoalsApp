pipeline{
    agent any
    tools{
        nodejs 'NODEJS23'
    }
    stages{
        stage{
            steps{
                sh 'npm -v'
            }
        }
        stage('Install dependencies')
        {
            steps{
            sh '''
                cd backend/
                npm install 
                '''
            }
        }
        stage('npm test')
        {
            steps{
            sh '''
              cd backend
              npm test
              '''
            }
        }
        stage('npm coverage')
        {
            steps{
            sh '''
              cd backend
              npm run coverage
              '''
            }
        }
    } 
}