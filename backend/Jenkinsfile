pipeline{
    agent any
    stages{
        stage('Install dependencies')
        {
            steps{
            sh '''
                cd backend/
                npm install --no-audit
                '''
            }
        }
        stage('npm test')
        {
            steps{
            sh '''
              cd backend/
              npm test
              '''
            }
        }
        stage('npm coverage')
        {
            steps{
            sh '''
              cd backend/
              npm run coverage
              '''
            }
        }
    } 
}